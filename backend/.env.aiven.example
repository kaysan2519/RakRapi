# Salin ke .env.aiven. File .env.aiven dan private/ diabaikan Git.
# Isi dengan akun aplikasi Aiven yang haknya sesuai README, bukan akun admin.
DB_MODE=aiven
DB_HOST=
DB_PORT=
DB_NAME=rakrapi
DB_SSL_CA=private/aiven/ca.pem
DB_USER=
DB_PASSWORD=
AUTH_DB_USER=
AUTH_DB_PASSWORD=
PEGAWAI_DB_USER=
PEGAWAI_DB_PASSWORD=
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
JWT_SECRET=
PORT=3001
# Folder bawaan mode Aiven: private/uploads-aiven/db-rakrapi
