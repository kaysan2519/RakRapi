# Salin file ini menjadi .env lalu isi nilai privatnya. Jangan unggah .env ke Git.
NODE_ENV=development
PORT=3000

# Database MySQL
# Laragon lokal: DB_HOST=localhost, DB_PORT=3306, DB_SSL=false
# Aiven: isi host/port layanan, akun rakrapi_app (bukan avnadmin), DB_SSL=true, dan DB_SSL_CA_BASE64
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rakrapi
DB_SSL=false
DB_SSL_CA_BASE64=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Password
BCRYPT_SALT_ROUNDS=12

# Cloudinary (foto produk privat)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS (* untuk development, atau isi domain web saat production)
CORS_ORIGIN=*
