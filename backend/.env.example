# Satu file aktif: salin ke .env. Jangan unggah .env ke Git.
# Pilih laragon ATAU aiven. Untuk Aiven, isi host/port layanan dan CA.
DB_MODE=laragon
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL_CA=
# Contoh CA untuk Aiven: private/aiven/ca.pem
# Akun health; akun dengan tugas berbeda tetap memiliki izin berbeda.
DB_USER=
DB_PASSWORD=
DB_NAME=rakrapi
HOST=127.0.0.1
PORT=3000
# Daftar domain web yang diizinkan (pisahkan koma, jangan pakai *). Kosongkan untuk lokal Android.
CORS_ORIGIN=
AUTH_DB_USER=rakrapi_auth
AUTH_DB_PASSWORD=
PEGAWAI_DB_USER=rakrapi_pegawai
PEGAWAI_DB_PASSWORD=
JWT_SECRET=
CATALOG_DB_USER=rakrapi_katalog
CATALOG_DB_PASSWORD=

# Opsional: hanya dipakai npm run cek:aiven -- --admin, tidak oleh API.
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=

# Opsional: akun demo yang sudah ada, untuk pengujian lokal saja.
DEMO_PEMILIK_PASSWORD=
DEMO_PEGAWAI_PASSWORD=
